    "1. Open Tools > Export vault." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Öffne Werkzeuge > Tresor exportieren."
          }
        }
      }
    },
    "2. Choose the format „.json“ or „.csv“, not the encrypted one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Wähle das Format „.json“ oder „.csv“, nicht das verschlüsselte."
          }
        }
      }
    },
    "3. Save the file in Files (On My iPhone)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Sichere die Datei in der Dateien-App (Auf meinem iPhone)."
