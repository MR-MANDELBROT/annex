            "value" : "Version"
          }
        }
      }
    },
    "Waiting for you" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wartet auf dich"
          }
        }
      }
    },
    "Websites" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Websites"
          }
        }
      }
    },
    "What is where" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was ist wo"
          }
        }
      }
    },
    "When your agent needs to sign in somewhere, Annex finds the login here and asks you first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muss sich dein Agent irgendwo anmelden, findet Annex die Anmeldung hier und fragt dich vorher."
          }
        }
      }
    },
    "With a secret here, Annex sends the current code together with the password." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit einem Geheimnis hier schickt Annex den aktuellen Code zusammen mit dem Passwort."
          }
        }
      }
    },
    "With one-time codes: %lld" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Einmalcodes: %lld"
          }
        }
      }
    },
    "worked last" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "zuletzt erreicht"
          }
        }
      }
    },
    "Workspace" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbeitsplatz"
          }
        }
      }
    },
    "Workspace request" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anfrage für den Arbeitsplatz"
          }
        }
      }
    },
    "Your agent" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Agent"
          }
        }
      }
    },
    "Your agent asks, you approve with Face ID. It never sees the password." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Agent fragt, du gibst mit Face ID frei. Er sieht das Passwort nie."
          }
        }
      }
    },
    "Your agent never sees a password. Annex fills it into the workspace for you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Agent sieht nie ein Passwort. Annex trägt es für dich im Arbeitsplatz ein."
          }
        }
      }
    },
    "Your agent never sees them. Annex fills them in for it after you approve." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Agent sieht sie nie. Annex trägt sie für ihn ein, nachdem du freigegeben hast."
          }
        }
      }
    },
    "Your Mac" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Mac"
          }
        }
      }
    },
    "Your Mac and the workspace, live, with touch and keyboard." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Mac und der Arbeitsplatz, live, mit Touch und Tastatur."
          }
        }
      }
    },
    "your network (%@)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "dein Netzwerk (%@)"
          }
        }
      }
    },
    "Your password app (Bitwarden, 1Password, Passwords) fills these fields with its own Face ID. Annex sends them once and doesn't keep them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Passwort-App (Bitwarden, 1Password, Passwörter) füllt diese Felder mit ihrem eigenen Face ID. Annex sendet sie einmal und behält sie nicht."
          }
        }
      }
    },
    "Your passwords" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Passwörter"
          }
        }
      }
    },
    "Your passwords stay on this iPhone, in its keychain. They aren't synced or backed up." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Passwörter bleiben auf diesem iPhone, in seinem Schlüsselbund. Sie werden weder synchronisiert noch gesichert."
          }
        }
      }
    },
    "Your passwords stay on this iPhone, locked with Face ID." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Passwörter bleiben auf diesem iPhone, geschützt mit Face ID."
          }
        }
      }
    }
