    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kamera liest den Kopplungscode, den aOS auf deinem Mac zeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The camera scans the pairing code that aOS shows on your Mac."
