      }
    },
    "Pair only with your own Mac. Annex on the Mac adds this iPhone's key to your user's SSH keys there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopple nur mit deinem eigenen Mac. Annex auf dem Mac trägt den Schlüssel dieses iPhones dort bei den SSH-Schlüsseln deines Benutzers ein."
