    },
    "Claude Code is not installed" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code ist nicht installiert"
          }
        }
      }
    },
    "Click Open System Settings if macOS asks, then switch on Annex Helper. If notices at the top right cover the switch, close them with their x first. %@ enters the password itself. This happens only once." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fragt macOS, klicke auf „Systemeinstellungen öffnen“, dann schalte „Annex Helper“ ein. Verdecken Hinweise oben rechts den Schalter, schließe sie vorher mit ihrem x. Das Passwort gibt %@ selbst ein. Das ist nur einmal nötig."
          }
        }
      }
    },
    "Click Open System Settings if macOS asks, then switch on Annex Helper. When macOS asks for the password to allow Annex Helper, click Enter the workspace password. Only then: if another window asks, click Not Now." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke auf „Systemeinstellungen öffnen“, falls macOS fragt, und schalte dann „Annex Helper“ ein. Fragt macOS nach dem Passwort, um Annex Helper zu erlauben, klicke auf „Passwort des Arbeitsplatzes eingeben“. Nur dann: Fragt ein anderes Fenster, klicke auf „Nicht jetzt“."
          }
        }
      }
    },
    "Close after %lld min without activity" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach %lld Min. ohne Aktivität schließen"
