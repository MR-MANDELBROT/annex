      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter %@ hat ein anderer Rechner geantwortet, oder der SSH-Schlüssel des Macs hat sich geändert. Hast du den Mac neu eingerichtet, kopple ihn neu."
