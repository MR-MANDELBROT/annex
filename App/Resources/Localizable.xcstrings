{
  "sourceLanguage" : "en",
  "strings" : {
    "\"%@\" reachable in the Claude app" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ in der Claude-App erreichbar"
          }
        }
      }
    },
    "[*.]google.com" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "[*.]google.com"
          }
        }
      }
    },
    "%@ creates the virtual Mac and installs macOS into it. This takes about 10 minutes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ legt den virtuellen Mac an und installiert macOS darin. Das dauert etwa 10 Minuten."
          }
        }
      }
    },
    "%@ gives Claude its own Mac: a virtual Mac with its own screen and browser, separate from yours. Claude uses it for tasks that need a website or an app, and you reach Claude from the Claude app on your phone at any time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gibt Claude einen eigenen Mac: einen virtuellen Mac mit eigenem Bildschirm und Browser, getrennt von deinem. Claude nutzt ihn für Aufgaben, die eine Website oder eine App brauchen, und du erreichst Claude jederzeit über die Claude-App auf deinem Handy."
          }
        }
      }
    },
    "%@ is ready." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist bereit."
          }
        }
      }
    },
    "%@ lives in the menu bar. It starts with your Mac and keeps the session running." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wohnt in der Menüleiste. Es startet mit deinem Mac und hält die Sitzung am Laufen."
          }
        }
      }
    },
    "%@ runs Claude Code, Anthropic's own app, with your Claude subscription (Pro, Max or Team). You install it and sign in yourself; %@ never sees your sign-in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nutzt Claude Code, die App von Anthropic, mit deinem Claude-Abo (Pro, Max oder Team). Du installierst es und meldest dich selbst an; %@ sieht deine Anmeldung nie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ runs Claude Code, Anthropic's own app, with your Claude subscription (Pro, Max or Team). You install it and sign in yourself; %2$@ never sees your sign-in."
          }
        }
      }
    },
    "1. Open the workspace window. System Settings is already open there at General > Sharing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Öffne das Fenster des Arbeitsplatzes. Dort sind die Systemeinstellungen schon bei Allgemein > Teilen geöffnet."
          }
        }
      }
    },
    "1. Register tools" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Werkzeuge eintragen"
          }
        }
      }
    },
    "2. Start once" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Einmal starten"
          }
        }
      }
    },
    "2. Switch on Screen Sharing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Schalte „Bildschirmfreigabe“ ein."
          }
        }
      }
    },
    "3. Run in the background" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Im Hintergrund laufen lassen"
          }
        }
      }
    },
    "3. When macOS asks for a password, click \"Enter the workspace password\" in the window." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Fragt macOS nach einem Passwort, klicke im Fenster auf „Passwort des Arbeitsplatzes eingeben“."
          }
        }
      }
    },
    "4. Come back here and click Check." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4. Komm hierher zurück und klicke auf „Prüfen“."
          }
        }
      }
    },
    "About 60 GB of free disk space are needed (%lld GB free)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwa 60 GB freier Speicher werden gebraucht (%lld GB frei)."
          }
        }
      }
    },
    "Asking Apple for the newest macOS" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frage Apple nach dem neuesten macOS"
          }
        }
      }
    },
    "At least 8 GB of memory are required (this Mac has %llu GB)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindestens 8 GB Arbeitsspeicher sind nötig (dieser Mac hat %llu GB)."
          }
        }
      }
    },
    "Changes to sign-ins apply to the workspace at its next start." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Änderungen an den Anmeldungen gelten ab dem nächsten Start des Arbeitsplatzes."
