    },
    "Last step: %@ registers its tools with Claude Code and starts the session \"%@\". Start it once here: Claude Code asks whether you trust the folder and whether to enable Remote Control. Answer yes to both, then close the terminal." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letzter Schritt: %@ trägt seine Werkzeuge in Claude Code ein und startet die Sitzung „%@“. Starte sie hier einmal: Claude Code fragt, ob du dem Ordner vertraust und ob Remote Control an sein soll. Beantworte beides mit Ja und schließe dann das Terminal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Last step: %1$@ registers its tools with Claude Code and starts the session \"%2$@\". Start it once here: Claude Code asks whether you trust the folder and whether to enable Remote Control. Answer yes to both, then close the terminal."
          }
        }
      }
    },
    "Look up the newest macOS" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neuestes macOS suchen"
          }
        }
      }
    },
    "macOS %@ (%@), about 18 GB. The download continues where it stopped if you quit %@ or lose the connection." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS %@ (%@), etwa 18 GB. Der Download macht dort weiter, wo er aufgehört hat, wenn du %@ beendest oder die Verbindung abbricht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "macOS %1$@ (%2$@), about 18 GB. The download continues where it stopped if you quit %3$@ or lose the connection."
          }
        }
      }
    },
    "macOS %@ (%@), about 26 GB. The download continues where it stopped if you quit %@ or lose the connection." : {
      "localizations" : {
