    },
    "Starting the workspace for the first time" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte den Arbeitsplatz zum ersten Mal"
          }
        }
      }
    },
    "Stay signed in on" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angemeldet bleiben bei"
          }
        }
      }
    },
    "Step %lld of %lld" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schritt %lld von %lld"
