      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über der Grenze von %lld"
          }
        }
      }
    },
    "Active within the last %lld hours" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiv in den letzten %lld Stunden"
          }
        }
      }
    },
