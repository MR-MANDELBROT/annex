    " · with one-time code" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " · mit Einmalcode"
          }
        }
      }
    },
    "„%@“" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“"
          }
        }
      }
    },
    "%@ answered with a different SSH key (%@). If the Mac was set up again, pair it again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hat mit einem anderen SSH-Schlüssel geantwortet (%2$@). Wurde der Mac neu eingerichtet, kopple ihn neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ answered with a different SSH key (%2$@). If the Mac was set up again, pair it again."
          }
        }
      }
    },
    "%@ asks for a one-time code" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bittet um einen Einmalcode"
          }
        }
      }
    },
    "%@ asks for a sign-in" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bittet um eine Anmeldung"
          }
        }
      }
    },
    "%@ asks for help" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bittet um Hilfe"
          }
        }
      }
    },
    "%@ asks for your help" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bittet dich um Hilfe"
          }
        }
      }
    },
    "%@ asks to sign in" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ möchte sich anmelden"
          }
        }
      }
    },
    "%@ didn't accept the login." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat die Anmeldung nicht angenommen."
          }
        }
      }
    },
    "%@ didn't accept the user name or password." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat Benutzername oder Passwort nicht angenommen."
          }
        }
      }
    },
    "%@ didn't accept this iPhone's key. Add the key to ~/.ssh/authorized_keys there (Settings > This iPhone)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat den Schlüssel dieses iPhones nicht angenommen. Trag ihn dort in ~/.ssh/authorized_keys ein (Einstellungen > Dieses iPhone)."
          }
        }
      }
    },
    "%@ is new. Its key: %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ist neu. Sein Schlüssel: %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is new. Its key: %2$@"
          }
        }
      }
    },
    "%@ now presents %@. That happens when the computer was set up again, but it can also mean that someone is in between. Only continue if you know why it changed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ zeigt jetzt %2$@. Das passiert, wenn der Rechner neu eingerichtet wurde, kann aber auch heißen, dass jemand dazwischen sitzt. Mach nur weiter, wenn du weißt, warum er sich geändert hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ now presents %2$@. That happens when the computer was set up again, but it can also mean that someone is in between. Only continue if you know why it changed."
          }
        }
      }
    },
    "%@ to open aOS" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ zum Öffnen von aOS"
          }
        }
      }
    },
    "%@ wants to open the workspace" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ möchte den Arbeitsplatz öffnen"
          }
        }
      }
    },
    "%@@%@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@@%2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@@%2$@"
          }
        }
      }
    },
    "%lld:%@ left" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "noch %1$lld:%2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld:%2$@ left"
          }
        }
      }
    },
    "A Mac of its own for your coding agent." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein eigener Mac für deinen Coding-Agent."
          }
        }
      }
    },
    "A sign-in request shows which of your Bitwarden logins fit the website, by name and user name, never a password. You approve one with Face ID or your passcode." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Anmeldeanfrage zeigt, welche deiner Bitwarden-Anmeldungen zur Website passen, mit Name und Benutzername, nie mit Passwort. Du gibst eine mit Face ID oder deinem Code frei."
          }
        }
      }
    },
    "Account name" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accountname"
          }
        }
      }
    },
    "Add a computer" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rechner hinzufügen"
          }
        }
      }
    },
    "Add this iPhone's public key (Settings > SSH key of this iPhone) to ~/.ssh/authorized_keys on that computer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trag den öffentlichen Schlüssel dieses iPhones (Einstellungen > SSH-Schlüssel dieses iPhones) auf dem Rechner in ~/.ssh/authorized_keys ein."
