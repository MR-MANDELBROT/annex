    "Status" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Status"
          }
        }
      }
    },
    "Stay signed in on" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angemeldet bleiben bei"
          }
        }
      }
