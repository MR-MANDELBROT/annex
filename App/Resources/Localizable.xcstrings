    "Step %lld of %lld" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schritt %lld von %lld"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Step %1$lld of %2$lld"
          }
        }
      }
    },
    "Switch on aOS Helper in the workspace window." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte „aOS Helper“ im Fenster des Arbeitsplatzes ein."
          }
        }
      }
    },
    "Switch on Screen Sharing below" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte unten die Bildschirmfreigabe ein"
          }
        }
      }
    },
    "Switch on Screen Sharing. If notices at the top right cover the switch, close them with their x." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte „Bildschirmfreigabe“ ein. Verdecken Hinweise oben rechts den Schalter, schließe sie mit ihrem x."
          }
        }
      }
    },
    "Sync Now" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jetzt synchronisieren"
          }
        }
      }
    },
    "Talking to Bitwarden …" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spreche mit Bitwarden …"
          }
        }
      }
    },
    "Tap “Pair with your Mac”." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf „Mit deinem Mac koppeln“."
          }
        }
      }
    },
    "That isn't an email address." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist keine E-Mail-Adresse."
          }
        }
      }
    },
    "The code expired" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Code ist abgelaufen"
          }
        }
      }
    },
    "The code is valid until %@ and only once." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Code gilt bis %@ und nur einmal."
          }
        }
      }
    },
    "The download isn't Bitwarden's signed command line tool (%@), so %@ deleted it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Download ist nicht das signierte Befehlszeilenprogramm von Bitwarden (%1$@), deshalb hat %2$@ ihn gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The download isn't Bitwarden's signed command line tool (%1$@), so %2$@ deleted it."
          }
        }
      }
    },
    "The first time, %@ downloads Bitwarden's official command line tool from Bitwarden (about 45 MB) and checks that Bitwarden signed it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim ersten Mal lädt %@ das offizielle Befehlszeilenprogramm von Bitwarden (etwa 45 MB) und prüft, dass Bitwarden es signiert hat."
          }
        }
      }
    },
    "The helper isn't installed in the workspace yet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Helfer ist im Arbeitsplatz noch nicht installiert."
          }
        }
      }
    },
    "The iPhone connects over SSH: encrypted, and only with its own key." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das iPhone verbindet sich über SSH: verschlüsselt und nur mit seinem eigenen Schlüssel."
          }
        }
      }
    },
    "The Mac doesn't go to sleep by itself while a session or a kept conversation runs. Closing a laptop's lid still puts it to sleep." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Mac schläft nicht von selbst ein, solange eine Sitzung oder eine gehaltene Unterhaltung läuft. Zuklappen schickt ein MacBook trotzdem in den Ruhezustand."
          }
        }
      }
    },
    "The master password isn't right." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Master-Passwort stimmt nicht."
          }
        }
      }
    },
    "The workspace is off" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Arbeitsplatz ist aus"
          }
        }
      }
    },
    "The workspace is suspended after each use and continues exactly where it was, signed in everywhere." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Arbeitsplatz wird nach jeder Nutzung angehalten und macht genau dort weiter, überall angemeldet."
          }
        }
      }
    },
    "The workspace only opens when you say yes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Arbeitsplatz öffnet sich nur, wenn du ja sagst."
          }
        }
      }
    },
    "The workspace runs macOS. %@ downloads it directly from Apple." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Arbeitsplatz läuft macOS. %@ lädt es direkt von Apple."
          }
        }
      }
    },
    "The workspace shuts down after each use; websites forget sign-ins, except the domains below (fewer captchas there)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Arbeitsplatz fährt nach jeder Nutzung herunter; Websites vergessen Anmeldungen, außer bei den Domains unten (dort gibt es weniger Captchas)."
          }
        }
      }
    },
    "The workspace starts for the first time, without the setup assistant. %@ creates its account, allows remote access only from this Mac, installs Google Chrome and turns off sleep and automatic updates." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Arbeitsplatz startet zum ersten Mal, ohne Einrichtungsassistent. %@ legt sein Konto an, erlaubt Fernzugriff nur von diesem Mac, installiert Google Chrome und schaltet Ruhezustand und automatische Updates aus."
          }
        }
      }
    },
    "This Bitwarden item isn't a login." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Bitwarden-Eintrag ist keine Anmeldung."
          }
        }
      }
    },
    "This is Claude Code's own terminal. %@ never sees what you type here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist das Terminal von Claude Code. %@ sieht nie, was du hier tippst."
          }
        }
      }
    },
    "This Mac" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Mac"
          }
        }
      }
    },
    "This Mac can't run virtual machines. aOS needs a Mac with Apple silicon and can't run inside a virtual machine itself." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Mac kann keine virtuellen Maschinen ausführen. aOS braucht einen Mac mit Apple Silicon und kann nicht selbst in einer virtuellen Maschine laufen."
          }
        }
      }
    },
    "Try Again" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erneut versuchen"
          }
        }
      }
    },
    "Turn On …" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einschalten …"
          }
        }
      }
    },
    "Turn on screen sharing" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildschirmfreigabe einschalten"
          }
        }
      }
    },
    "Type the code yourself" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Code selbst eingeben"
          }
        }
      }
    },
    "Unlock" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entsperren"
          }
        }
      }
    },
    "Unlock Bitwarden so sign-in requests can offer your logins. The master password goes to Bitwarden's tool and isn't stored." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entsperre Bitwarden, damit Anmeldeanfragen deine Anmeldungen anbieten können. Das Master-Passwort geht an das Programm von Bitwarden und wird nicht gespeichert."
          }
        }
      }
    },
    "Unlock it to see your logins for this website." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entsperre es, um deine Anmeldungen für diese Website zu sehen."
          }
        }
      }
    },
    "Unlocked" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entsperrt"
          }
        }
      }
    },
    "Unlocked until %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entsperrt bis %@"
          }
        }
      }
    },
    "Update" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualisieren"
          }
        }
      }
    },
    "User name or email" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benutzername oder E-Mail"
          }
        }
      }
    },
    "Verification code" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestätigungscode"
          }
        }
      }
    },
    "waiting for the network" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "wartet aufs Netz"
          }
        }
      }
    },
    "Waiting for the network" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wartet auf das Netzwerk"
          }
        }
      }
    },
    "Waiting until %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wartet bis %@"
          }
        }
      }
    },
    "Websites forget their sign-ins when it closes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Websites vergessen ihre Anmeldungen, wenn er schließt."
          }
        }
      }
    },
    "Welcome to %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Willkommen bei %@"
          }
        }
      }
    },
    "When a website needs a sign-in, your agent asks; you approve and %@ fills it in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Braucht eine Website eine Anmeldung, fragt dein Agent; du gibst frei und %@ trägt sie ein."
          }
        }
      }
    },
    "When a website needs a sign-in, your agent asks; you approve on your iPhone or Mac and %@ fills it in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Braucht eine Website eine Anmeldung, fragt dein Agent; du gibst auf dem iPhone oder Mac frei und %@ trägt sie ein."
          }
        }
      }
    },
    "When macOS asks for a password, click \"Enter the workspace password\" in the window." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fragt macOS nach einem Passwort, klicke im Fenster auf „Passwort des Arbeitsplatzes eingeben“."
          }
        }
      }
    },
    "When macOS asks for a password, let %@ enter it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fragt macOS nach einem Passwort, lass es %@ eingeben."
          }
        }
      }
    },
    "When the Claude app or a terminal closes a conversation, %@ keeps it running in the background, so you can continue it from the Claude app on your phone. Open it on the Mac again and %@ hands it back at once." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließt die Claude-App oder ein Terminal eine Unterhaltung, führt %@ sie im Hintergrund weiter, damit du sie in der Claude-App auf deinem Handy fortsetzen kannst. Öffnest du sie am Mac wieder, gibt %@ sie sofort ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When the Claude app or a terminal closes a conversation, %1$@ keeps it running in the background, so you can continue it from the Claude app on your phone. Open it on the Mac again and %2$@ hands it back at once."
          }
        }
      }
    },
    "When the Claude app or a terminal closes a conversation, %@ keeps it running, so it stays in the Claude app on your phone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließt die Claude-App oder ein Terminal eine Unterhaltung, führt %@ sie weiter, damit sie in der Claude-App auf deinem Handy bleibt."
          }
        }
      }
    },
    "When your agent needs to sign in, you see which of your Bitwarden logins fit the website and approve one on your iPhone or here. %@ then gets that one login from Bitwarden and types it into the workspace. Your agent never sees it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muss sich dein Agent anmelden, siehst du, welche deiner Bitwarden-Anmeldungen zur Website passen, und gibst eine auf dem iPhone oder hier frei. %@ holt dann genau diese Anmeldung aus Bitwarden und tippt sie in den Arbeitsplatz. Dein Agent sieht sie nie."
          }
        }
      }
    },
    "Which agent should use the workspace? %@ adds itself to the agent's settings as an MCP server. You can connect more than one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcher Agent soll den Arbeitsplatz nutzen? %@ trägt sich in seinen Einstellungen als MCP-Server ein. Du kannst mehrere verbinden."
          }
        }
      }
    },
    "Workspace" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbeitsplatz"
          }
        }
      }
    },
    "You decide" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du entscheidest"
          }
        }
      }
    },
    "Your account has several ways to confirm it's you. Which one do you want to use?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Konto kennt mehrere Wege, zu bestätigen, dass du es bist. Welchen möchtest du nehmen?"
          }
        }
      }
    },
    "Your agent" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Agent"
          }
        }
      }
    },
    "Your agent asks for your help" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Agent bittet dich um Hilfe"
          }
        }
      }
    },
    "Your agent is working" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Agent arbeitet"
          }
        }
      }
    },
    "Your agent needs your help" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Agent braucht deine Hilfe"
          }
        }
      }
    },
    "Your Claude Code conversations stay in the Claude app on your phone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Claude-Code-Unterhaltungen bleiben in der Claude-App auf deinem Handy."
          }
        }
      }
    },
    "your email address" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "deine E-Mail-Adresse"
          }
        }
      }
    },
    "Your master password goes to Bitwarden's command line tool once and isn't stored. If Bitwarden asks for a code (two-step login, or because %@ is a new device for your account), you enter it here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Master-Passwort geht einmal an das Befehlszeilenprogramm von Bitwarden und wird nicht gespeichert. Fragt Bitwarden nach einem Code (zweistufige Anmeldung, oder weil %@ ein neues Gerät für dein Konto ist), gibst du ihn hier ein."
          }
        }
      }
    },
    "Yours (%@), signed by Bitwarden" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deins (%@), von Bitwarden signiert"
          }
        }
      }
    },
    "YubiKey (one-time password)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YubiKey (Einmalpasswort)"
          }
        }
      }
    }
  },
  "version" : "1.3"
}