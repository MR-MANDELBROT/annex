    },
    "Approve with %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit %@ freigeben"
          }
        }
      }
    },
    "Approved. aOS on your Mac gets this login from Bitwarden and fills it in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freigegeben. aOS auf deinem Mac holt diese Anmeldung aus Bitwarden und trägt sie ein."
          }
        }
      }
    },
    "Approving a sign-in always needs Face ID, whether or not the app itself is locked." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Anmeldung freizugeben braucht immer Face ID, ob die App selbst gesperrt ist oder nicht."
          }
        }
      }
    },
