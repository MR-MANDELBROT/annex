      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annex"
          }
        }
      }
    },
    "Annex %@ on the Mac answers." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annex %@ auf dem Mac antwortet."
          }
        }
      }
    },
    "Annex couldn't fill it in. The agent can ask again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annex konnte sie nicht eintragen. Der Agent kann noch einmal fragen."
          }
        }
      }
    },
    "Annex is locked" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annex ist gesperrt"
          }
        }
      }
    },
    "Annex isn't installed on the Mac where it was paired. Open Annex on the Mac and pair again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annex ist auf dem Mac nicht mehr dort installiert, wo es beim Koppeln war. Öffne Annex auf dem Mac und kopple neu."
          }
        }
      }
    },
    "Annex may not delete it there. Delete it in the Files app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annex darf sie dort nicht löschen. Lösche sie in der Dateien-App."
          }
        }
      }
    },
    "Annex may not use the local network. Allow it in Settings > Privacy & Security > Local Network, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annex darf das lokale Netzwerk nicht nutzen. Erlaube es unter Einstellungen > Datenschutz & Sicherheit > Lokales Netzwerk und versuch es dann noch einmal."
          }
        }
      }
    },
    "Annex may not use the local network. Allow it in Settings > Privacy & Security > Local Network." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annex darf das lokale Netzwerk nicht nutzen. Erlaube es unter Einstellungen > Datenschutz & Sicherheit > Lokales Netzwerk."
          }
        }
      }
    },
    "Annex on the Mac didn't answer in time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annex auf dem Mac hat nicht rechtzeitig geantwortet."
          }
        }
      }
    },
    "Annex on the Mac doesn't answer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annex auf dem Mac antwortet nicht."
          }
        }
      }
    },
    "Annex on the Mac isn't answering right now (%@). It keeps trying." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annex auf dem Mac antwortet gerade nicht (%@). Es versucht es weiter."
          }
        }
      }
    },
    "Annex on the Mac isn't answering right now. It keeps trying." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annex auf dem Mac antwortet gerade nicht. Es versucht es weiter."
          }
        }
      }
    },
    "Annex on the Mac isn't ready: %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annex auf dem Mac ist nicht bereit: %@"
          }
        }
      }
    },
    "Annex on the Mac lists paired devices by this name." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter diesem Namen führt Annex auf dem Mac die gekoppelten Geräte auf."
          }
        }
      }
    },
    "Annex on the Mac said no." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annex auf dem Mac hat abgelehnt."
          }
        }
      }
    },
    "Annex on the Mac sent an answer this app doesn't understand." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annex auf dem Mac hat eine Antwort geschickt, die diese App nicht versteht."
          }
        }
      }
    },
    "Annex on the Mac stopped answering." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annex auf dem Mac antwortet nicht mehr."
          }
        }
      }
    },
    "Annex on your iPhone" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annex auf deinem iPhone"
          }
        }
      }
    },
    "Annex remembers the key and warns you if it ever changes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annex merkt sich den Schlüssel und warnt dich, falls er sich je ändert."
          }
        }
      }
    },
    "Approve with %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit %@ freigeben"
          }
        }
      }
    },
    "Approved sign-ins go once, encrypted over SSH, to Annex on your Mac, which types them into the workspace. Neither the app nor the Mac keeps them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freigegebene Anmeldungen gehen einmal verschlüsselt über SSH an Annex auf deinem Mac, das sie im Arbeitsplatz einträgt. Weder die App noch der Mac behalten sie."
          }
        }
      }
    },
    "Asking the Mac" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frage den Mac"
          }
        }
      }
    },
    "At %@ a different computer answered, or the Mac's SSH key changed. If you set the Mac up again, pair it again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter %@ hat ein anderer Rechner geantwortet, oder der SSH-Schlüssel des Macs hat sich geändert. Hast du den Mac neu eingerichtet, kopple ihn neu."
          }
        }
      }
    },
