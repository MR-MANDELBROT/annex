    "A few steps are left." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es fehlen noch ein paar Schritte."
          }
        }
      }
    },
    "A session that always runs in %@'s folder, with the workspace tools." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Sitzung, die immer im Ordner von %@ läuft, mit den Werkzeugen für den Arbeitsplatz."
          }
        }
      }
    },
    "A sign-in is waiting for you" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Anmeldung wartet auf dich"
          }
        }
      }
    },
    "About 75 GB of free disk space are needed (%lld GB free)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwa 75 GB freier Speicher werden gebraucht (%lld GB frei)."
